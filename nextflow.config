manifest {
    name = 'OncoFlow Atlas'
    author = 'Sarvenaz Mahmoudzadeh'
    version = '2.0.0'
    nextflowVersion = '>=24.04.0'
}
params {
    expression = "${projectDir}/data/demo/expression.csv"
    variants = "${projectDir}/data/demo/variants.csv"
    metadata = "${projectDir}/data/demo/metadata.csv"
    cna = false
    source_manifest = "${projectDir}/data/demo/source_manifest.json"
    outdir = "${projectDir}/results/nextflow"
    cohort_name = 'synthetic-demo'
    min_vaf = 0.05
    min_purity = 0.4
    top_n = 12
}
process {
    executor = 'local'
    errorStrategy = 'terminate'
    cache = 'deep'
    cpus = 1
    memory = '2 GB'
    time = '30m'
}
env.PYTHONDONTWRITEBYTECODE = '1'
report { enabled = true; file = "${params.outdir}/nextflow-report.html"; overwrite = true }
timeline { enabled = true; file = "${params.outdir}/nextflow-timeline.html"; overwrite = true }
trace { enabled = true; file = "${params.outdir}/nextflow-trace.tsv"; overwrite = true }
profiles {
    local { process.executor = 'local' }
    public {
        params.expression = "${projectDir}/data/public/prepared/expression.csv"
        params.variants = "${projectDir}/data/public/prepared/variants.csv"
        params.metadata = "${projectDir}/data/public/prepared/metadata.csv"
        params.cna = "${projectDir}/data/public/prepared/cna.csv"
        params.source_manifest = "${projectDir}/data/public/prepared/source_manifest.json"
        params.cohort_name = 'tcga-chol-pancan'
    }
    docker { docker.enabled = true; process.container = 'oncoflow-atlas:2.0.0' }
    slurm {
        process.executor = 'slurm'
        process.queue = System.getenv('SLURM_QUEUE') ?: 'compute'
    }
}
