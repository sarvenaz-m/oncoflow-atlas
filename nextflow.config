manifest {
    name = 'OncoFlow Atlas'
    author = 'Sarvenaz Mahmoudzadeh'
    version = '1.0.0'
    nextflowVersion = '>=24.04.0'
}

process {
    errorStrategy = { task.exitStatus in [137, 143] ? 'retry' : 'terminate' }
    maxRetries = 2
    cache = 'lenient'
    withName: MULTIOMIC_INTEGRATION {
        cpus = 2
        memory = '4 GB'
        time = '30m'
    }
}

report {
    enabled = true
    file = "${params.outdir ?: 'results/nextflow'}/nextflow-report.html"
    overwrite = true
}

timeline {
    enabled = true
    file = "${params.outdir ?: 'results/nextflow'}/nextflow-timeline.html"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.outdir ?: 'results/nextflow'}/nextflow-trace.tsv"
    overwrite = true
}

profiles {
    local {
        process.executor = 'local'
    }
    slurm {
        process.executor = 'slurm'
        process.queue = System.getenv('SLURM_QUEUE') ?: 'compute'
    }
    awsbatch {
        process.executor = 'awsbatch'
        process.queue = System.getenv('AWS_BATCH_QUEUE') ?: 'REPLACE_ME'
        workDir = System.getenv('NXF_WORK') ?: 's3://REPLACE_ME/oncoflow/work'
        aws.region = System.getenv('AWS_REGION') ?: 'eu-west-1'
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }
}
